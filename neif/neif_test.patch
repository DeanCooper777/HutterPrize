+      if (l > bl) { bl = l; bb = b; }
+    }
+    mb = bb;
+    ml = bl;
+  }
+  if (!neif_ppmd_shadow_) neif_ppmd_shadow_ = new PPMD::PPMD(*byte_model_, neif_spec_byte_, PPMD::PPMD::Shadow());
+  neif_spec_byte_ = (unsigned int)g;
