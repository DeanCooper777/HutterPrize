+    neif_test::g_on = true;
+    neif_test::g_start = 0;
+    neif_test::g_end = *run_bytes;
+    neif_test::g_warm_target = 0;
+    neif_test::g_skip = false;
+    neif_test::g_warm_from = 0;
+    neif_stream_path = temp_path;
+    neif_test::g_out_path = out_path;
